# 환경 변수 템플릿. 복사해서 .env.local 로 쓰고 값을 채운다 (.env.local 은 git에 안 올라감).
#   cp .env.example .env.local

# Supabase (Settings > API Keys). 신규 키 체계: publishable(=구 anon) / secret(=구 service_role)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# 서버 전용. 절대 NEXT_PUBLIC_ 붙이지 말 것 (브라우저에 노출됨)
SUPABASE_SECRET_KEY=
# Postgres 직접 접속용 (앱은 안 씀. CLI/마이그레이션용)
SUPABASE_DB_PASSWORD=

# Google 로그인: Client ID/Secret 은 Supabase 대시보드 Authentication > Providers > Google 에 넣는다 (앱 env 불필요)

# 게임 이미지 저장소 공개 주소 (저장소 미정. 비우면 /assets 로컬 사용)
NEXT_PUBLIC_ASSET_BASE_URL=
